<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Leve11 | Windows com mais fôlego" Width="1120" Height="820" MinWidth="940" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F5F7" FontFamily="Segoe UI" Foreground="#182A3B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E4EAF0"/><Setter Property="Foreground" Value="#182A3B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="17,12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F3F6F9"/><Setter Property="RowHeight" Value="46"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,12"/><Setter Property="Background" Value="#E7EDF2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5F7">
  <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="105"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
  <Border Background="#112D3C" Padding="28,20"><Grid>
   <StackPanel><TextBlock Text="LEVE11" FontSize="30" FontWeight="Bold" Foreground="#77E2C3"/><TextBlock Text="Menos no início. Mais espaco para o que importa." Foreground="#E0EAF0" FontSize="15" Margin="0,7,0,0"/></StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="320"><TextBlock Text="PORTÁTIL / SEM PROCESSO RESIDENTE" Foreground="#77E2C3" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="Windows 11  •  usuário atual" Foreground="#E0EAF0" Margin="0,8,0,0" HorizontalAlignment="Right"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="RAM EM USO" Foreground="#607285" FontSize="11"/><TextBlock x:Name="UsedText" Text="Analisando..." FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="MemoryDetail" Text="Leitura pontual do sistema" Foreground="#607285" FontSize="11"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="DISPONÍVEL" Foreground="#607285" FontSize="11"/><TextBlock x:Name="AvailableText" Text="--" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Inclui memória recuperavel pelo Windows" Foreground="#607285" FontSize="11"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="PERFIL SUGERIDO" Foreground="#607285" FontSize="11"/><TextBlock x:Name="ProfileText" Text="--" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Você revisa antes de aplicar" Foreground="#607285" FontSize="11"/></StackPanel>
   <Button x:Name="RefreshButton" Grid.Column="3" Content="Atualizar análise" VerticalAlignment="Center"/>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="2" Margin="28,0,28,14" Background="White" BorderBrush="#D8E1E8">
   <TabItem Header="01  Ajustes"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="Um ponto de partida para sua memória" FontSize="20" FontWeight="SemiBold"/><ComboBox x:Name="ProfileCombo" Width="180" HorizontalAlignment="Right" SelectedIndex="0"><ComboBoxItem Content="8 GB / Essencial" Tag="8"/><ComboBoxItem Content="12 GB / Equilibrado" Tag="12"/><ComboBoxItem Content="16 GB / Conforto" Tag="16"/><ComboBoxItem Content="32 GB+ / Sob demanda" Tag="32"/></ComboBox></DockPanel>
    <TextBlock x:Name="ProfileHint" Grid.Row="1" Margin="0,10,0,14" Foreground="#607285"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TweaksPanel"/></ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button x:Name="PreviewButton" Content="Revisar e aplicar seleção" Background="#147D68" Foreground="White"/><TextBlock Text="Backup dos valores originais antes de cada alteração." VerticalAlignment="Center" Foreground="#607285"/></DockPanel>
   </Grid></TabItem>
   <TabItem Header="02  Inicialização"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Escolha o que não precisa abrir no login" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Lista de entradas Run do seu usuário. Nada é marcado automaticamente. Segurança, drivers e sincronização reconhecidos ficam protegidos. Veja comandos e preserve o que não reconhecer." Margin="0,8,0,14" Foreground="#607285"/>
    <DataGrid x:Name="StartupGrid" Grid.Row="2"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Desativar" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Protected}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Aplicativo" Binding="{Binding Title}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="Comando registrado" Binding="{Binding Command}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Orientação" Binding="{Binding Note}" Width="220" IsReadOnly="True"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="StartupApplyButton" Content="Revisar inicialização" Background="#147D68" Foreground="White"/><Button x:Name="StartupSettingsButton" Content="Todos os apps no Windows"/><Button x:Name="StartupFolderButton" Content="Pasta Inicializar"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="03  Aplicativos"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Remova apenas o que você não usa" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Somente apps opcionais instalados aparecem aqui. Desinstalação pode apagar dados locais e não é desfeita pelo backup de ajustes. Um app instalado, mas parado, pode não consumir RAM." Margin="0,8,0,14" Foreground="#607285"/>
    <DataGrid x:Name="AppsGrid" Grid.Row="2"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Remover" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Aplicativo" Binding="{Binding Title}" Width="170" IsReadOnly="True"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="140" IsReadOnly="True"/><DataGridTextColumn Header="O que você perde" Binding="{Binding Impact}" Width="*" IsReadOnly="True"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="RemoveAppsButton" Content="Revisar desinstalação" Background="#147D68" Foreground="White"/><Button x:Name="InstalledSettingsButton" Content="Outros apps instalados"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="04  Diagnóstico"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Meça com o mesmo uso, depois de reiniciar" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="DiagnosticHint" Grid.Row="1" Margin="0,8,0,14" Foreground="#607285" Text="Working set por processo inclui memória compartilhada: não some está lista para calcular o uso total."/>
    <DataGrid x:Name="ProcessGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="120"/><DataGridTextColumn Header="Working set (MB)" Binding="{Binding WorkingSetMB}" Width="200"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ExportButton" Content="Salvar medição (JSON)"/><Button x:Name="CompareButton" Content="Comparar com medição salva"/><Button x:Name="EffectsButton" Content="Efeitos visuais do Windows"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="05  Histórico"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Você pode voltar aos valores anteriores" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="Ajustes são restaurados do mais recente para o mais antigo. Mudancas feitas por outros programas são preservadas e sinalizadas como conflito. Apps removidos exigem reinstalação pela Store." Margin="0,8,0,14" Foreground="#607285"/>
    <DataGrid x:Name="HistoryGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data / hora" Binding="{Binding Created}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding DisplayType}" Width="130"/><DataGridTextColumn Header="Resultado" Binding="{Binding DisplayStatus}" Width="170"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="RestoreButton" Content="Restaurar sessão selecionada" Background="#147D68" Foreground="White"/><Button x:Name="DetailsButton" Content="Ver detalhes"/><Button x:Name="StoreButton" Content="Reinstalar apps pela Store"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="06  Drivers"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Investigue a falha antes de trocar o driver" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="DriverHint" Grid.Row="1" Text="Clique em Diagnosticar. Códigos PnP e eventos são indícios; não provam a causa do bug. Crie backups enquanto o dispositivo funciona. Um backup feito agora não recupera uma versão anterior." Margin="0,8,0,14" Foreground="#607285"/>
    <DataGrid x:Name="DriverGrid" Grid.Row="2" IsReadOnly="True" RowHeight="NaN" MinRowHeight="46"><DataGrid.Columns><DataGridTextColumn Header="Dispositivo" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="65"/><DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="130"/><DataGridTextColumn Header="Pacote" Binding="{Binding InfName}" Width="95"/><DataGridTextColumn Header="Orientação" Binding="{Binding Advice}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button x:Name="DriverAnalyzeButton" Content="Diagnosticar"/><Button x:Name="DriverBackupButton" Content="Backup do selecionado"/><Button x:Name="DriverRestoreButton" Content="Reinstalar backup"/><Button x:Name="DriverRollbackButton" Content="Reverter driver..."/><Button x:Name="DriverEventsButton" Content="Eventos recentes"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="07  Malware"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Verificação pelo Microsoft Defender" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="MalwareHint" Grid.Row="1" Text="Consultar estado não executa uma varredura. Nenhuma lista vazia comprova ausência de malware. Ameaças antigas podem aparecer no histórico mesmo após tratamento." Margin="0,8,0,12" Foreground="#607285"/>
    <TextBox x:Name="DefenderDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="130" BorderThickness="0" Padding="10" Background="#F3F6F9" Text="Estado ainda não consultado." Margin="0,0,0,12"/>
    <DataGrid x:Name="ThreatGrid" Grid.Row="3" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ameaça reportada" Binding="{Binding ThreatName}" Width="*"/><DataGridTextColumn Header="Ativa (Defender)" Binding="{Binding IsActive}" Width="140"/><DataGridTextColumn Header="Execução reportada" Binding="{Binding DidThreatExecute}" Width="160"/><DataGridTextColumn Header="ID de severidade" Binding="{Binding SeverityID}" Width="140"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="4" Margin="0,14,0,0"><Button x:Name="MalwareAnalyzeButton" Content="Consultar estado"/><Button x:Name="SignatureButton" Content="Atualizar definições"/><Button x:Name="QuickScanButton" Content="Verificação rápida" Background="#147D68" Foreground="White"/><Button x:Name="FullScanButton" Content="Completa"/><Button x:Name="OfflineScanButton" Content="Offline..."/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#E5EBF0" Padding="28,10"><DockPanel><Button x:Name="SecurityShortcutButton" DockPanel.Dock="Right" Content="Segurança do Windows" Margin="14,0,0,0"/><StackPanel><TextBlock x:Name="StatusText" Text="Preparando análise local..." FontWeight="SemiBold"/><ProgressBar x:Name="BusyBar" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Foreground="#147D68" Background="#D2DCE4"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>
